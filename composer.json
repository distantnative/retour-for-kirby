{
	"name": "distantnative/retour-for-kirby",
	"description": "Manage redirects and track 404s right from the Kirby CMS Panel",
	"license": "MIT",
	"type": "kirby-plugin",
	"version": "5.7.0",
	"homepage": "https://distantnative.com/retour-for-kirby/",
	"authors": [
		{
			"name": "Nico Hoffmann",
			"email": "nico@getkirby.com"
		}
	],
	"require": {
		"php": "~8.3.0 || ~8.4.0 || ~8.5.0",
		"getkirby/cms": "^6.0",
		"getkirby/composer-installer": "^1.1"
	},
	"require-dev": {
		"getkirby/cms": "dev-v6/develop as 6.0.0-beta.1"
	},
	"autoload-dev": {
		"psr-4": {
			"Kirby\\": "tests/"
		}
	},
	"extra": {
		"installer-name": "retour",
		"kirby": {
			"compatible": "^6.0"
		},
		"kirby-cms-path": false
	},
	"scripts": {
		"fix": "php-cs-fixer fix",
		"test": "phpunit --stderr"
	},
	"minimum-stability": "beta",
	"prefer-stable": true,
	"config": {
		"allow-plugins": {
			"getkirby/composer-installer": true
		}
	}
}
