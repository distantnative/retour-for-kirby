{
	"name": "distantnative/retour-for-kirby",
	"description": "Manage redirects and track 404s right from the Kirby CMS Panel",
	"license": "MIT",
	"type": "kirby-plugin",
	"version": "6.0.1",
	"homepage": "https://distantnative.com/retour-for-kirby/",
	"authors": [
		{
			"name": "Nico Hoffmann",
			"email": "nico@getkirby.com"
		}
	],
	"require": {
		"php": "~8.3.0 || ~8.4.0 || ~8.5.0 || ~8.6.0",
		"getkirby/cms": "^6.0",
		"getkirby/composer-installer": "^1.1"
	},
	"autoload-dev": {
		"psr-4": {
			"Kirby\\": "tests/"
		}
	},
	"extra": {
		"installer-name": "retour",
		"kirby": {
			"compatible": "^6.0"
		},
		"kirby-cms-path": false
	},
	"scripts": {
		"fix": "cpx getkirby/php-cs:0.3.0 fix",
		"test": "cpx brianium/paratest:7.20.0"
	},
	"config": {
		"allow-plugins": {
			"getkirby/composer-installer": true
		}
	}
}
